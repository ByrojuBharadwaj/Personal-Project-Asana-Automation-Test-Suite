{
  "name": "asana-automation-test",
  "version": "1.0.0",
  "description": "Data-driven Playwright test suite for Asana-like demo application",
  "main": "app.ts",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:chromium": "npx playwright test --project=chromium",
    "test:chromium:headed": "npx playwright test --project=chromium --headed",
    "test:debug": "npx playwright test --debug",
    "report": "npx playwright show-report",
    "start:web": "ts-node app.ts"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
